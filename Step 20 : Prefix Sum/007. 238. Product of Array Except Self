https://www.geeksforgeeks.org/problems/product-array-puzzle4525/1


class Solution {
    public int[] productExceptSelf(int[] arr) {

          int pre=1;
        int post=1;
        int[] res = new int[arr.length];
        Arrays.fill(res,1);
        for(int i=0;i<arr.length;i++) {
            res[i] *= pre;
            pre *= arr[i];
        }
        for(int i=arr.length-1;i>=0;i--) {
            res[i] *= post;
            post *= arr[i];
        }
        return res;
        
    }
}
