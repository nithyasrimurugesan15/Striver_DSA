https://leetcode.com/problems/maximum-points-you-can-obtain-from-cards/submissions/1989207893/

class Solution {
    public int maxScore(int[] cardPoints, int k) {
        int lsum=0;
         int msum=0;
        for(int i=0;i<k;i++) {
            lsum+=cardPoints[i];
        }
        msum = lsum;
        int rsum=0;
        int rindex = cardPoints.length-1;
        for(int j=k-1;j>=0;j--) {

            lsum-=cardPoints[j];
            rsum+=cardPoints[rindex];
            msum = Math.max(msum,lsum+rsum);
            rindex--;

        }
    
         return msum;
        
    }
}

