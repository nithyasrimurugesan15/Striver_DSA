https://www.geeksforgeeks.org/problems/max-consecutive-one/1

class Solution {
    public int maxConsecBits(int[] arr) {
        // code here
          int i=0;
          int j=0;
          int ms=0;
          while(j<arr.length) {
              if(arr[i]!=arr[j]) {
                  i=j;
              }
               ms = Math.max(ms,j-i+1);
               j++;
          }
          return ms;
    }
}
