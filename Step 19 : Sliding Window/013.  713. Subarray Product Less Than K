class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {
        int product = 1, i = 0;
        int count = 0;
        int j = 0;
        if(k <= 1) return 0;
        for(j = 0; j < nums.length; j ++){
            product *= nums[j];

            while(product >= k && i <= j){
                System.out.print(i + " ");
                // count += j - i;
                product /= nums[i];
                i++;
            }
                count += j - i + 1;

        }
            // while(i < nums.length){
            //     System.out.print(i + " ");
            //     count += j - i;
            //     product = product / nums[i];
            //     i++;
            // }
        return count;
    }
}
