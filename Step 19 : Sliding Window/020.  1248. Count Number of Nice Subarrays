https://leetcode.com/problems/count-number-of-nice-subarrays/description/

class Solution {
    public int numberOfSubarrays(int[] nums, int k) {
        
        return atMost(nums,k) - atMost(nums,k-1);
        
    }
    public int atMost(int[] nums,int k) {
        int oddcount=0;
        int j=0;
        int i=0;
        int cnt=0;
        while(j<nums.length) {
            if(nums[j]%2==1) {
                oddcount++;
            }
            while(oddcount > k) {
                if(nums[i]%2==1) {
                    oddcount--;
                }
                i++;
            }
            cnt+=(j-i+1);
            j++;

        }
        return cnt;
        
    }
}
