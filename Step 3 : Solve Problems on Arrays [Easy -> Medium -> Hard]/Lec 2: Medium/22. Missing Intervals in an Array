class Solution {
    public List<List<Integer>> missingRanges(int[] arr, int lower, int upper) 
    {
        List<List<Integer>> res = new ArrayList<>();

        int i=0;
        int len = arr.length;
        int srt=0;


        HashSet<Integer> al = new HashSet<>();

        for (int x : arr) {
          al.add(x);
         }

        while(lower<=upper) {

            if(!al.contains(lower)) {
                srt = lower;
                lower++;
                while(lower<=upper && !al.contains(lower)) {
                    lower++;
                }
                int end = lower - 1;

                ArrayList<Integer> sub = new ArrayList<>();

                sub.add(srt);
                sub.add(end);
                res.add(sub);

        }
        else {
                lower++;
            }


        }
        return res;

    }
}
