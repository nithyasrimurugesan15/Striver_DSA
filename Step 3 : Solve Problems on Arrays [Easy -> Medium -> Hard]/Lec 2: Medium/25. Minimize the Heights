class Solution {
    public int getMinDiff(int[] arr, int k) {
        // code here
        if(arr.length==1){
            return 0;
        }
        Arrays.sort(arr);
        int sml = arr[0]+k;
        int lar=arr[arr.length-1]-k;
        int ans = arr[arr.length-1] - arr[0];
        for(int i=0;i<arr.length-1;i++) {
            int minh = Math.min(sml,arr[i+1]-k);
            int maxh=Math.max(lar,arr[i]+k);
            
            if(arr[i+1]-k < 0) {
                continue;
            }
            ans = Math.min(ans,maxh-minh);
        }
        return ans;
    }
}
