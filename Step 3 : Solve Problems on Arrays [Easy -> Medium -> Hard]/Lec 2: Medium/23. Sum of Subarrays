BRUTE:

class Solution {
    public int subarraySum(int[] arr) {
        // code here
       int n = arr.length;
              int result = 0, temp = 0;

              for (int i = 0; i < n; i++) {

                  temp = 0;
                  for (int j = i; j < n; j++) {

                      temp += arr[j];
                      result += temp;
                  }
              }
              return result;
    }
}

OPTIMAL :

class Solution {
    public int subarraySum(int[] arr) {
    
     int n = arr.length;
              int result = 0;

              for (int i = 0; i < n; i++) {

                 result += (arr[i] * (n-i) * (i+1) );
                  
              }
              return result;
    }
}
