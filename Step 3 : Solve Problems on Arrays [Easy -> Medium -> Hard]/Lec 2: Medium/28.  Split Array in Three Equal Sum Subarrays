class Solution {

    public List<Integer> findSplit(int[] arr) {
        // Return an array of possible answer, driver code will judge and return true or
        // false based on
        
        List<Integer> res = new ArrayList<>();
        
        int tot=0;
        
        for(int i : arr) {
            tot+=i;
        }
        
        if(tot % 3 !=0) {
            res.add(-1);
            res.add(-1);
            return res;
        }
        
        int target = tot/3;
        
        int sum=0;
        int first =-1;
        for(int i=0;i<arr.length;i++) {
            sum+=arr[i];
            if(sum==target) {
                first = i;
                break;
            }
        }
        
        sum=0;
        
        for(int i=first+1;i<arr.length;i++) {
            sum+=arr[i];
            if(sum==target) {
                res.add(first);
                res.add(i);
                return res;
            }
        }
       res.add(-1);
       res.add(-1); 
       return res;
        
        
    }
}
