Brute:

Time: O(n²)
Space: O(n)

class Solution {
    public void rotate(int[][] m) {
        int r=m.length;
        int c=m[0].length;
        int[][] rot = new int[r][c];

        for(int i=0;i<r;i++) {
            for(int j=0;j<c;j++) {
                rot[j][r-i-1] =m[i][j];
            }
        }
        for(int i=0;i<r;i++) {
            for(int j=0;j<c;j++) {
                m[i][j] =rot[i][j];
            }
        }
    }
}

Optimal

Time: O(n²)
Space: O(1)

class Solution {
    public void rotate(int[][] matrix) {
        for(int i=0;i<matrix.length;i++){
            for(int j=i+1;j<matrix.length;j++) {
                int temp=matrix[i][j];
                matrix[i][j]=matrix[j][i];
                matrix[j][i]=temp;
            }
        }
        for(int i=0;i<matrix.length;i++) {
            int l=0;
            int r=matrix.length-1;
            while(l<r) {
                int temp=matrix[i][l];
                matrix[i][l]=matrix[i][r];
                matrix[i][r]=temp;
                l++;
                r--;
            }
            }
    }
}
