class Solution {
    public int maxTripletProduct(int[] arr) {
        // code here
        
        Arrays.sort(arr);
        
        int len = arr.length;
        int res = Math.max( (arr[0]*arr[1]*arr[len-1]), 
        (arr[len-1]*arr[len-2]*arr[len-3]) );
        
        return res;
    }
    
};
