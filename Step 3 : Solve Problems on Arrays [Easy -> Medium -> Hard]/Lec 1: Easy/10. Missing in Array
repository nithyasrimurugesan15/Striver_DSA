class Solution {
    int missingNum(int arr[]) {
        // code here
        int n=arr.length+1;
        for(int i=0;i<arr.length;i++){
            n^=(i+1)^arr[i];
        }
        return n;
    }
}

brute:

 class Solution {
   int missingNum(int arr[]) {
        
      long n = arr.length + 1;
        
       long sum = (n * (n + 1)) / 2;
        
         long arrSum = 0;
        for(int num : arr) {
           arrSum += num;
       }
         return (int)(sum - arrSum);
    }
 }
