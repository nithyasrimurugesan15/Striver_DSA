https://www.geeksforgeeks.org/problems/third-largest-element/1

class Solution {
    public int thirdLargest(List<Integer> arr) {
        // code here
        int max=Integer.MIN_VALUE;
        int smax=Integer.MIN_VALUE;
        int tmax=Integer.MIN_VALUE;
        for(int i=0;i<arr.size();i++) {
            if(arr.get(i)>=max) {
                tmax=smax;
                smax=max;
                max=arr.get(i);
            }
            else if(arr.get(i)>=smax && arr.get(i)!=max) {
                tmax=smax;
                smax=arr.get(i);
            }
            else if(arr.get(i)>=tmax && arr.get(i) != smax){
                tmax=arr.get(i);
            }
        }
        return tmax==Integer.MIN_VALUE ? -1 : tmax;
    }
}
