class Solution {
    ArrayList<Integer> findTwoElement(int arr[]) {
        // code here
        ArrayList<Integer> res  = new ArrayList<>();
      
        int rep=-1;
        int mis=-1;
        
        int[] freq = new int[arr.length+1];
        
        for(int i=0;i<arr.length;i++) {
            freq[arr[i]]++;
        }
        
        for(int i=1;i<=arr.length;i++) {
            if(freq[i]==0) {
                mis=i;
            }
            if(freq[i]==2) {
                rep=i;
            }
        }
        
        res.add(rep);
        res.add(mis);
        
        return res;
        
    }
}
