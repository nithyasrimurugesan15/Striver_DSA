https://www.geeksforgeeks.org/problems/kadanes-algorithm-1587115620/1


class Solution {
    public int maxSubArray(int[] nums) {

        int currs=0;
        int mx=Integer.MIN_VALUE;
        for(int i:nums) {
            currs+=i;
            if(currs>mx){
                mx=currs;
            }
            if(currs<0) {
                currs=0;
            }
        }
        return mx;

        
    }
}
