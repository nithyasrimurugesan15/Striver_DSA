https://www.geeksforgeeks.org/problems/pair-sum-in-a-sorted-and-rotated-array/1

 O(n) Time and O(1) Space

public boolean pairInSortedRotated(int[] arr, int target) {
    int n = arr.length;

    // Step 1: Find pivot (largest element)
    int pivot = -1;
    for(int i = 0; i < n - 1; i++) {
        if(arr[i] > arr[i + 1]) {
            pivot = i;
            break;
        }
    }

    // If not rotated
    if(pivot == -1) pivot = n - 1;

    int left = (pivot + 1) % n; // smallest
    int right = pivot;          // largest

    while(left != right) {
        int sum = arr[left] + arr[right];

        if(sum == target) return true;

        if(sum < target) {
            left = (left + 1) % n;
        } else {
            right = (n + right - 1) % n;
        }
    }

    return false;
}
