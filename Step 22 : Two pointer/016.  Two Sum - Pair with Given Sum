O(n × log(n)) time and O(1) space

Approach 1 :

class Solution {
    boolean twoSum(int arr[], int target) {
        
        if(arr.length==1) {
            return false;
        }
        
        Arrays.sort(arr);
        
        int i=0;
        int j=arr.length-1;
        while(i<j) {
            int sum=arr[i]+arr[j];
            if(sum==target) {
                return true;
            }
            else if(sum<target) {
                i++;
            }
            else{
                j--;
            }
        }
        return false;
        
    }
}

 
