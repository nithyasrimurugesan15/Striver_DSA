https://leetcode.com/problems/two-sum-ii-input-array-is-sorted/description/

class Solution {
    public int[] twoSum(int[] nums, int t) {
        int s=0;
        int e = nums.length-1;
        for(int i=0;i<nums.length;i++){
            if(nums[s]+nums[e] == t ) {
                return new int[]{s+1,e+1};
            }
            else if(nums[s]+nums[e] < t ){
                s++;
            }
            else{
                e--;
            }
        }
        return new int[]{-1,-1};
        
    }
}
