https://leetcode.com/problems/trapping-rain-water/description/

class Solution {
    public int trap(int[] h) {
        int l=0;
        int r =h.length-1;
        int lm=h[l];
        int rm=h[r];
        int wcnt=0;
        while(l<r) {
            if(lm<rm) {
                l++;
                lm=Math.max(h[l],lm);
                wcnt+=lm-h[l];
            }
            else{
                r--;
                rm=Math.max(rm,h[r]);
                wcnt+=rm-h[r];
            }


        }
        return wcnt;
        
    }
}
