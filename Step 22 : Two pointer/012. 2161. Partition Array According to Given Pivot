class Solution {
    public int[] pivotArray(int[] nums, int pivot) {

       int[] ans = new int[nums.length];
       int k=0;
       for(int i=0;i<nums.length;i++){
        if(nums[i]<pivot){
            ans[k] = nums[i];
            k++;
            }
        }

        for(int i=0;i<nums.length;i++) {
            if(nums[i]==pivot){
                 ans[k++]=nums[i];
            }
           
        }
        for(int i=0;i<nums.length;i++){
        if(nums[i]>pivot){
            ans[k++] = nums[i];
            }
        }
       return ans;
        
    }
}



another approach:

class Solution {
    public int[] pivotArray(int[] nums, int pivot) {

        int[] ans = new int[nums.length];
        int l=0;
        int r=nums.length-1;
        for(int i=0;i<nums.length;i++) {
            if(nums[i]<pivot) {
                ans[l]=nums[i];
                l++;
            }
            if(nums[nums.length-i-1]>pivot) {
                ans[r]=nums[nums.length-i-1];
                r--;
            }
        }

        while(l<=r){
            ans[l++]=pivot;
            ans[r--]=pivot;
        }
        return ans;
        
    }
}
